{
  "name": "remove-schema",
  "version": "2.0.1",
  "description": "Remove unwanted structured data from supported WordPress plugins and themes.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "files": [
    "autoload.php",
    "assets/build",
    "!assets/build/.gitkeep",
    "languages",
    "!languages/.gitkeep",
    "remove-schema.php",
    "README.txt",
    "src",
    "uninstall.php"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:admin",
    "build:admin": "wp-scripts build assets/src/admin/index.js --output-path=assets/build/admin && node bin/guard-asset-metadata.mjs",
    "clean": "node bin/clean.mjs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "lint:css": "wp-scripts lint-style \"assets/src/**/*.{css,scss}\"",
    "lint:js": "wp-scripts lint-js assets/src",
    "package:release": "npm run build && npm run package:zip",
    "package:zip": "wp-scripts plugin-zip --root-folder=remove-schema && node bin/finalize-plugin-zip.mjs",
    "start": "wp-scripts start assets/src/admin/index.js --output-path=assets/build/admin"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "@wordpress/env": "^12.0.0",
    "@wordpress/scripts": "^37.0.0"
  },
  "overrides": {
    "js-yaml@>=5 <6": "^5.5.0",
    "katex": "^0.18.2",
    "postcss-selector-parser": "^7.1.7",
    "qs": "^6.16.1",
    "serialize-javascript": "^7.1.2",
    "smol-toml": "^1.9.1"
  },
  "homepage": "https://plugin.nl/remove-schema",
  "author": {
    "name": "Tim van Iersel",
    "email": "tim@plugin.nl",
    "url": "https://plugin.nl"
  }
}

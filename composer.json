{
  "name": "timvaniersel/removeschema",
  "description": "Remove unwanted structured data from supported WordPress plugins and themes.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "phpunit/phpunit": "^11.5.55",
    "sirbrillig/phpcs-variable-analysis": "^3.0",
    "squizlabs/php_codesniffer": "^3.13.6",
    "wp-coding-standards/wpcs": "^3.4.1",
    "php-stubs/wordpress-stubs": "^7.1"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests/"
    ]
  },
  "scripts": {
    "lint": [
      "@phpcs",
      "@phpstan"
    ],
    "phpcs": "phpcs",
    "phpstan": "phpstan analyse",
    "phpunit": "phpunit",
    "test": [
      "@phpunit"
    ]
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "authors": [
    {
      "name": "Tim van Iersel",
      "email": "tim@plugin.nl",
      "homepage": "https://plugin.nl"
    }
  ]
}

{
  "name": "timvaniersel/removeschema",
  "description": "Remove all Schema Markup / Structured data (Microdata, RDFa and/or JSON-ld) that you don’t want on your site.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^1.12",
    "phpstan/phpstan-deprecation-rules": "^1.2",
    "phpunit/phpunit": "^10.5",
    "sirbrillig/phpcs-variable-analysis": "^2.12",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "php-stubs/wordpress-stubs": "^6.8"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests/"
    ]
  },
  "scripts": {
    "lint": [
      "@phpcs",
      "@phpstan"
    ],
    "phpcs": "phpcs",
    "phpstan": "phpstan analyse",
    "phpunit": "phpunit",
    "test": [
      "@phpunit"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "authors": [
    {
      "name": "Tim van Iersel",
      "email": "tim@plugin.nl",
      "homepage": "https://plugin.nl"
    }
  ]
}
